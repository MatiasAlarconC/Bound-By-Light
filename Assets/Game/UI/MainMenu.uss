/* BOUND BY LIGHT — MainMenu.uss */

.root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #080e16;
    align-items: center;
    justify-content: center;
}

.background {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("project://database/Assets/Game/UI/Art/background.png");
    -unity-background-scale-mode: scale-and-crop;
    background-color: #020810;
}

.slug-creature {
    position: absolute;
    left: 1%;
    bottom: 1%;
    width: 180px;
    height: 180px;
    background-image: url("project://database/Assets/Characters/DarkBrother/Idle_Babosa/0001.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.70;
}

.angel-creature {
    position: absolute;
    right: 1%;
    bottom: 1%;
    width: 140px;
    height: 190px;
    background-image: url("project://database/Assets/Characters/LightBrother/BaseForm/0001.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.70;
}

.menu-content {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-bottom: 80px;
}

.title-img {
    width: 720px;
    height: 300px;
    margin-bottom: 36px;
    background-image: url("project://database/Assets/Characters/UI/logo.png");
    -unity-background-scale-mode: scale-to-fit;
    display: flex;
}

.title-text-fallback {
    align-items: center;
    margin-bottom: 44px;
    rotate: -2.5deg;
    display: none;
}

.title-bound {
    -unity-font: url("project://database/Assets/Game/Fonts/Caveat-Bold%20FONT.ttf");
    font-size: 104px;
    color: #dce8f5;
    -unity-text-align: middle-center;
}

.title-bylight {
    -unity-font: url("project://database/Assets/Game/Fonts/Caveat-Bold%20FONT.ttf");
    font-size: 60px;
    color: #8aa0b8;
    letter-spacing: 14px;
    margin-top: -14px;
    -unity-text-align: middle-center;
}

.button-stack {
    flex-direction: column;
    align-items: center;
}

/* ── BUTTONS ────────────────────────────────────────── */

.menu-btn {
    -unity-font: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.ttf");
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    margin-top: 8px;
    margin-bottom: 8px;
    border-radius: 50px;
    transition-property: background-color, color, border-color, scale, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    cursor: hand;
}

/* Primary — golden / call-to-action */
.btn-primary {
    font-size: 13px;
    width: 280px;
    padding-top: 14px;
    padding-bottom: 14px;
    background-color: rgba(232, 160, 48, 0.08);
    color: #e8a030;
    border-width: 1.5px;
    border-color: rgba(232, 160, 48, 0.45);
}

.btn-primary:hover {
    background-color: rgba(232, 160, 48, 0.18);
    color: #ffd077;
    border-color: rgba(255, 200, 80, 0.90);
    scale: 1.05 1.05;
    translate: 0 -3px;
}

.btn-primary:active {
    scale: 0.96 0.96;
    translate: 0 1px;
    background-color: rgba(232, 160, 48, 0.28);
}

/* Secondary — muted blue, used for "continuar" */
.btn-secondary {
    font-size: 13px;
    width: 280px;
    padding-top: 14px;
    padding-bottom: 14px;
    background-color: rgba(60, 90, 120, 0.12);
    color: #7a9ab5;
    border-width: 1.5px;
    border-color: rgba(80, 115, 150, 0.35);
}

.btn-secondary:hover {
    background-color: rgba(80, 120, 160, 0.22);
    color: #c0d8f0;
    border-color: rgba(110, 160, 210, 0.65);
    scale: 1.05 1.05;
    translate: 0 -3px;
}

.btn-secondary:active {
    scale: 0.96 0.96;
    translate: 0 1px;
}

/* Danger — "nueva partida", muted red */
.btn-danger {
    font-size: 13px;
    width: 280px;
    padding-top: 14px;
    padding-bottom: 14px;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(180, 80, 70, 0.65);
    border-width: 1px;
    border-color: rgba(160, 60, 55, 0.22);
}

.btn-danger:hover {
    background-color: rgba(160, 50, 45, 0.12);
    color: rgba(220, 100, 90, 0.90);
    border-color: rgba(200, 70, 65, 0.40);
    scale: 1.04 1.04;
}

.btn-danger:active {
    scale: 0.97 0.97;
}

/* Confirm state — second click needed to confirm new game */
.btn-confirm {
    background-color: rgba(180, 60, 50, 0.18);
    color: #e87060;
    border-color: rgba(220, 80, 70, 0.60);
}

.btn-confirm:hover {
    background-color: rgba(200, 70, 60, 0.28);
    color: #ff9080;
    border-color: rgba(240, 90, 80, 0.85);
    scale: 1.04 1.04;
}

/* Tertiary — ghost/text button */
.btn-tertiary {
    font-size: 13px;
    width: 280px;
    padding-top: 14px;
    padding-bottom: 14px;
    background-color: rgba(0, 0, 0, 0);
    color: #4a6070;
    border-width: 1px;
    border-color: rgba(70, 95, 115, 0.22);
}

.btn-tertiary:hover {
    color: #90b0c8;
    border-color: rgba(100, 140, 170, 0.45);
    background-color: rgba(60, 90, 120, 0.08);
    scale: 1.04 1.04;
}

.btn-tertiary:active {
    scale: 0.97 0.97;
}

.credits {
    position: absolute;
    bottom: 18px;
    left: 0; right: 0;
    -unity-font: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.ttf");
    font-size: 9px;
    letter-spacing: 4px;
    color: rgba(74, 90, 110, 0.48);
    -unity-text-align: middle-center;
}

/* ── SETTINGS OVERLAY ─────────────────────────────── */

.settings-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.38s;
}

.hidden { display: none; }

.settings-backdrop {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(2, 6, 14, 0.88);
}

.settings-card {
    width: 500px;
    background-color: rgba(8, 15, 26, 0.97);
    border-width: 1px;
    border-color: rgba(100, 130, 160, 0.18);
    border-radius: 20px;
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 36px;
    padding-bottom: 36px;
}

.settings-title {
    -unity-font: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.ttf");
    font-size: 13px;
    letter-spacing: 5px;
    color: rgba(140, 170, 200, 0.70);
    -unity-text-align: middle-center;
    margin-bottom: 28px;
}

.slider-row { margin-bottom: 20px; }

.slider-head {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.slider-label {
    -unity-font: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.ttf");
    font-size: 10px;
    letter-spacing: 2px;
    color: rgba(90, 110, 130, 0.90);
}

.slider-value {
    -unity-font: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.ttf");
    font-size: 10px;
    color: #e8a030;
}

.bbl-slider { height: 24px; }

.bbl-slider .unity-base-slider__tracker {
    background-color: rgba(60, 80, 100, 0.35);
    border-radius: 2px;
    border-width: 0;
    height: 2px;
    margin-top: 11px;
}

.bbl-slider .unity-base-slider__dragger {
    background-color: #4a6070;
    border-radius: 50%;
    width: 14px;
    height: 14px;
    border-width: 2px;
    border-color: rgba(140, 180, 220, 0.25);
    margin-top: -7px;
}

.bbl-slider .unity-base-slider__dragger:hover {
    background-color: #e8a030;
    scale: 1.3 1.3;
}

.divider {
    height: 1px;
    background-color: rgba(60, 80, 100, 0.20);
    margin-top: 16px;
    margin-bottom: 16px;
}

.save-row {
    flex-direction: column;
    align-items: center;
    margin-top: 18px;
    margin-bottom: 4px;
}

.btn-save {
    width: 220px;
    font-size: 13px;
    letter-spacing: 4px;
}

.lbl-saved {
    -unity-font: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.ttf");
    font-size: 9px;
    letter-spacing: 2px;
    color: rgba(100, 200, 120, 0.80);
    -unity-text-align: middle-center;
    margin-top: 6px;
    height: 14px;
}

.close-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 4px;
}
