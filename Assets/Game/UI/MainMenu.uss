/* BOUND BY LIGHT — MainMenu.uss */

.root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #080e16;
    align-items: center;
    justify-content: center;
}

.background {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("project://database/Assets/Game/UI/Art/background.png");
    -unity-background-scale-mode: scale-and-crop;
    background-color: #020810;
}

.slug-creature {
    position: absolute;
    left: 1%;
    bottom: 1%;
    width: 180px;
    height: 180px;
    background-image: url("project://database/Assets/Characters/DarkBrother/Idle_Babosa/0001.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.70;
}

.angel-creature {
    position: absolute;
    right: 1%;
    bottom: 1%;
    width: 140px;
    height: 190px;
    background-image: url("project://database/Assets/Characters/LightBrother/BaseForm/0001.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.70;
}

.menu-content {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-bottom: 160px;
}

.title-img {
    width: 860px;
    height: 360px;
    margin-bottom: 28px;
    background-image: url("project://database/Assets/Characters/UI/logo.png");
    -unity-background-scale-mode: scale-to-fit;
    display: flex;
}

.title-text-fallback {
    align-items: center;
    margin-bottom: 44px;
    rotate: -2.5deg;
    display: none;
}

.title-bound {
    -unity-font-definition: url("project://database/Assets/Game/Fonts/Caveat-Bold.asset");
    font-size: 104px;
    color: #dce8f5;
    -unity-text-align: middle-center;
}

.title-bylight {
    -unity-font-definition: url("project://database/Assets/Game/Fonts/Caveat-Bold.asset");
    font-size: 60px;
    color: #8aa0b8;
    letter-spacing: 14px;
    margin-top: -14px;
    -unity-text-align: middle-center;
}

.button-stack {
    flex-direction: column;
    align-items: center;
}

/* ── BUTTONS ────────────────────────────────────────── */

.menu-btn {
    -unity-font-definition: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.asset");
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    margin-top: 5px;
    margin-bottom: 5px;
    border-radius: 50px;
    transition-property: background-color, color, border-color, scale, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    cursor: hand;
}

/* Primary — "continuar": sutil, azul grisáceo */
.btn-primary {
    font-size: 12px;
    width: 230px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: rgba(50, 70, 95, 0.10);
    color: rgba(175, 200, 225, 0.85);
    border-width: 1px;
    border-color: rgba(120, 150, 185, 0.45);
}

.btn-primary:hover {
    background-color: rgba(70, 100, 135, 0.18);
    color: rgba(210, 230, 250, 0.98);
    border-color: rgba(140, 175, 215, 0.70);
    scale: 1.04 1.04;
    translate: 0 -2px;
}

.btn-primary:active {
    scale: 0.97 0.97;
    translate: 0 1px;
    background-color: rgba(70, 100, 135, 0.25);
}

/* Secondary — no se usa en el menú principal */
.btn-secondary {
    font-size: 12px;
    width: 230px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: rgba(60, 90, 120, 0.12);
    color: #7a9ab5;
    border-width: 1px;
    border-color: rgba(80, 115, 150, 0.35);
}

/* Danger — "nueva partida": dorado/ámbar prominente */
.btn-danger {
    font-size: 12px;
    width: 230px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: rgba(232, 160, 48, 0.28);
    color: #f0b840;
    border-width: 1.5px;
    border-color: rgba(232, 160, 48, 0.75);
}

.btn-danger:hover {
    background-color: rgba(232, 160, 48, 0.40);
    color: #ffd070;
    border-color: rgba(255, 200, 80, 0.95);
    scale: 1.04 1.04;
    translate: 0 -2px;
}

.btn-danger:active {
    scale: 0.97 0.97;
    translate: 0 1px;
}

/* Confirm — segundo click nueva partida */
.btn-confirm {
    background-color: rgba(180, 60, 50, 0.18);
    color: #e87060;
    border-color: rgba(220, 80, 70, 0.60);
}

.btn-confirm:hover {
    background-color: rgba(200, 70, 60, 0.28);
    color: #ff9080;
    border-color: rgba(240, 90, 80, 0.85);
    scale: 1.04 1.04;
}

/* Tertiary — "configuración": muy sutil */
.btn-tertiary {
    font-size: 12px;
    width: 230px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(100, 125, 150, 0.75);
    border-width: 1px;
    border-color: rgba(70, 95, 120, 0.22);
}

.btn-tertiary:hover {
    color: rgba(150, 175, 200, 0.92);
    border-color: rgba(100, 135, 165, 0.45);
    background-color: rgba(50, 75, 100, 0.08);
    scale: 1.04 1.04;
}

.btn-tertiary:active {
    scale: 0.97 0.97;
}

.credits {
    position: absolute;
    bottom: 10px;
    left: 0; right: 0;
    -unity-font-definition: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.asset");
    font-size: 9px;
    letter-spacing: 4px;
    color: rgba(74, 90, 110, 0.48);
    -unity-text-align: middle-center;
}

/* ── SETTINGS OVERLAY ─────────────────────────────── */

.settings-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.38s;
}

.hidden { display: none; }

.settings-backdrop {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(2, 6, 14, 0.88);
}

.settings-card {
    position: relative;
    width: 480px;
    background-color: rgba(12, 18, 30, 0.96);
    border-width: 1px;
    border-color: rgba(70, 100, 130, 0.20);
    border-radius: 24px;
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 44px;
    padding-bottom: 36px;
}

/* Título usa Caveat para coincidir con la referencia */
.settings-title {
    -unity-font-definition: url("project://database/Assets/Game/Fonts/Caveat-Bold.asset");
    font-size: 30px;
    letter-spacing: 1px;
    color: rgba(200, 215, 235, 0.95);
    -unity-text-align: middle-center;
    margin-bottom: 28px;
    margin-top: 8px;
}

.slider-row { margin-bottom: 20px; }

.slider-head {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.slider-label {
    -unity-font-definition: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.asset");
    font-size: 10px;
    letter-spacing: 2px;
    color: rgba(120, 145, 170, 0.85);
}

.slider-value {
    -unity-font-definition: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.asset");
    font-size: 10px;
    letter-spacing: 1px;
    color: rgba(232, 160, 48, 0.90);
}

.bbl-slider { height: 24px; }

.bbl-slider .unity-base-slider__tracker {
    background-color: rgba(60, 80, 100, 0.35);
    border-radius: 2px;
    border-width: 0;
    height: 2px;
    margin-top: 11px;
}

.bbl-slider .unity-base-slider__dragger {
    background-color: #4a6070;
    border-radius: 50%;
    width: 14px;
    height: 14px;
    border-width: 2px;
    border-color: rgba(140, 180, 220, 0.25);
    margin-top: -7px;
}

.bbl-slider .unity-base-slider__dragger:hover {
    background-color: #e8a030;
    scale: 1.3 1.3;
}

.divider {
    height: 1px;
    background-color: rgba(60, 80, 100, 0.20);
    margin-top: 16px;
    margin-bottom: 16px;
}

.save-row {
    flex-direction: column;
    align-items: center;
    margin-top: 18px;
    margin-bottom: 4px;
}

.btn-save-sm {
    width: 160px;
    font-size: 11px;
    letter-spacing: 3px;
}

.settings-close-x {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: rgba(60, 80, 100, 0.18);
    color: rgba(140, 170, 200, 0.65);
    border-width: 1px;
    border-color: rgba(80, 110, 140, 0.25);
    font-size: 14px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
    cursor: hand;
    transition-property: background-color, color;
    transition-duration: 0.2s;
}

.settings-close-x:hover {
    background-color: rgba(160, 50, 45, 0.22);
    color: rgba(220, 100, 90, 0.90);
    border-color: rgba(180, 60, 55, 0.40);
}

.lbl-saved {
    -unity-font-definition: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.asset");
    font-size: 9px;
    letter-spacing: 2px;
    color: rgba(100, 200, 120, 0.80);
    -unity-text-align: middle-center;
    margin-top: 6px;
    height: 14px;
}
