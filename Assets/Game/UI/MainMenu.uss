/* BOUND BY LIGHT — MainMenu.uss */

.root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #080e16;
    align-items: center;
    justify-content: center;
}

.background {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("project://database/Assets/Game/UI/Art/background.png");
    -unity-background-scale-mode: scale-and-crop;
    background-color: #020810;
}

.slug-creature {
    position: absolute;
    left: 1%;
    bottom: 1%;
    width: 180px;
    height: 180px;
    background-image: url("project://database/Assets/Characters/DarkBrother/Idle_Babosa/0001.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.70;
}

.angel-creature {
    position: absolute;
    right: 1%;
    bottom: 1%;
    width: 140px;
    height: 190px;
    background-image: url("project://database/Assets/Characters/LightBrother/BaseForm/0001.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.70;
}

.menu-content {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-bottom: 50px;
}

.title-img {
    width: 720px;
    height: 300px;
    margin-bottom: 36px;
    background-image: url("project://database/Assets/Characters/UI/logo.png");
    -unity-background-scale-mode: scale-to-fit;
    display: flex;
}

.title-text-fallback {
    align-items: center;
    margin-bottom: 44px;
    rotate: -2.5deg;
    display: none;
}

.title-bound {
    -unity-font: url("project://database/Assets/Game/Fonts/Caveat-Bold%20FONT.ttf");
    font-size: 104px;
    color: #dce8f5;
    -unity-text-align: middle-center;
}

.title-bylight {
    -unity-font: url("project://database/Assets/Game/Fonts/Caveat-Bold%20FONT.ttf");
    font-size: 60px;
    color: #8aa0b8;
    letter-spacing: 14px;
    margin-top: -14px;
    -unity-text-align: middle-center;
}

.button-stack {
    flex-direction: column;
    align-items: center;
}

.menu-btn {
    -unity-font: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.ttf");
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    margin-top: 7px;
    margin-bottom: 7px;
    border-radius: 50px;
    transition-property: background-color, color, border-color, scale, translate;
    transition-duration: 0.38s;
    transition-timing-function: ease;
    cursor: hand;
}

.btn-primary {
    font-size: 16px;
    width: 272px;
    padding-top: 15px;
    padding-bottom: 15px;
    background-color: rgba(232, 160, 48, 0.10);
    color: #e8a030;
    border-width: 1.5px;
    border-color: rgba(232, 160, 48, 0.36);
}

.btn-primary:hover {
    background-color: rgba(232, 160, 48, 0.22);
    color: #f5c060;
    border-color: rgba(232, 160, 48, 0.80);
    scale: 1.045 1.045;
    translate: 0 -2px;
}

.btn-primary:active {
    scale: 0.955 0.955;
    background-color: rgba(232, 160, 48, 0.30);
}

.btn-secondary {
    font-size: 13px;
    width: 228px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: rgba(42, 53, 68, 0.12);
    color: #6a7a8a;
    border-width: 1px;
    border-color: rgba(74, 90, 110, 0.26);
}

.btn-secondary:hover {
    background-color: rgba(74, 90, 110, 0.20);
    color: #b0c0d2;
    border-color: rgba(106, 122, 142, 0.48);
    scale: 1.045 1.045;
    translate: 0 -2px;
}

.btn-tertiary {
    font-size: 11px;
    width: 184px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0);
    color: #5a6a7a;
    border-width: 0;
}

.btn-tertiary:hover {
    color: #9ab0c8;
}

.credits {
    position: absolute;
    bottom: 18px;
    left: 0; right: 0;
    -unity-font: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.ttf");
    font-size: 9px;
    letter-spacing: 4px;
    color: rgba(74, 90, 110, 0.48);
    -unity-text-align: middle-center;
}

/* ── SETTINGS OVERLAY ─────────────────────────────── */

.settings-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.38s;
}

.hidden { display: none; }

.settings-backdrop {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(2, 6, 14, 0.88);
}

.settings-card {
    width: 500px;
    background-color: rgba(8, 15, 26, 0.97);
    border-width: 1px;
    border-color: rgba(100, 130, 160, 0.18);
    border-radius: 20px;
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 36px;
    padding-bottom: 36px;
}

.settings-title {
    -unity-font: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.ttf");
    font-size: 13px;
    letter-spacing: 5px;
    color: rgba(140, 170, 200, 0.70);
    -unity-text-align: middle-center;
    margin-bottom: 28px;
}

.slider-row { margin-bottom: 20px; }

.slider-head {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.slider-label {
    -unity-font: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.ttf");
    font-size: 10px;
    letter-spacing: 2px;
    color: rgba(90, 110, 130, 0.90);
}

.slider-value {
    -unity-font: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.ttf");
    font-size: 10px;
    color: #e8a030;
}

.bbl-slider { height: 24px; }

.bbl-slider .unity-base-slider__tracker {
    background-color: rgba(60, 80, 100, 0.35);
    border-radius: 2px;
    border-width: 0;
    height: 2px;
    margin-top: 11px;
}

.bbl-slider .unity-base-slider__dragger {
    background-color: #4a6070;
    border-radius: 50%;
    width: 14px;
    height: 14px;
    border-width: 2px;
    border-color: rgba(140, 180, 220, 0.25);
    margin-top: -7px;
}

.bbl-slider .unity-base-slider__dragger:hover {
    background-color: #e8a030;
    scale: 1.3 1.3;
}

.divider {
    height: 1px;
    background-color: rgba(60, 80, 100, 0.20);
    margin-top: 16px;
    margin-bottom: 16px;
}

.lang-row { margin-bottom: 20px; }
.lang-label { margin-bottom: 10px; }
.lang-chips { flex-direction: row; }

.lang-chip {
    -unity-font: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.ttf");
    font-size: 9px;
    letter-spacing: 2px;
    color: rgba(80, 100, 120, 0.80);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(60, 80, 100, 0.28);
    border-radius: 20px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 7px;
    padding-bottom: 7px;
    margin-right: 8px;
    transition-property: background-color, color, border-color;
    transition-duration: 0.3s;
}

.lang-chip:hover {
    background-color: rgba(60, 80, 100, 0.18);
    color: #c8d8e8;
}

.lang-active {
    background-color: rgba(232, 160, 48, 0.12);
    border-color: rgba(232, 160, 48, 0.55);
    color: #e8a030;
}

.fullscreen-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

.bbl-toggle {
    width: 40px;
    height: 22px;
}

.bbl-toggle .unity-toggle__input {
    flex-direction: row;
    align-items: center;
}

.bbl-toggle .unity-toggle__checkmark {
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background-color: rgba(50, 70, 90, 0.45);
    border-width: 1px;
    border-color: rgba(60, 80, 100, 0.40);
}

.bbl-toggle:checked .unity-toggle__checkmark {
    background-color: rgba(232, 160, 48, 0.65);
    border-color: rgba(232, 160, 48, 0.80);
}

.save-row {
    flex-direction: column;
    align-items: center;
    margin-top: 18px;
    margin-bottom: 4px;
}

.btn-save {
    width: 220px;
    font-size: 13px;
    letter-spacing: 4px;
}

.lbl-saved {
    -unity-font: url("project://database/Assets/Game/Fonts/SpaceMono-Regular.ttf");
    font-size: 9px;
    letter-spacing: 2px;
    color: rgba(100, 200, 120, 0.80);
    -unity-text-align: middle-center;
    margin-top: 6px;
    height: 14px;
}

.close-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 4px;
}
