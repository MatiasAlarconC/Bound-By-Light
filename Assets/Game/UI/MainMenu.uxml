<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">

    <Style src="MainMenu.uss" />

    <ui:VisualElement name="root" class="root">

        <ui:VisualElement name="background" class="background" picking-mode="Ignore" />
        <ui:VisualElement name="slug" class="slug-creature" picking-mode="Ignore" />
        <ui:VisualElement name="angel" class="angel-creature" picking-mode="Ignore" />

        <ui:VisualElement name="menu-content" class="menu-content">

            <ui:VisualElement name="title-img" class="title-img" picking-mode="Ignore" />

            <ui:VisualElement name="title-text-fallback" class="title-text-fallback">
                <ui:Label text="Bound" class="title-bound" />
                <ui:Label text="by light" class="title-bylight" />
            </ui:VisualElement>

            <ui:VisualElement name="button-stack" class="button-stack">
                <ui:Button text="jugar ahora"    name="btn-play"      class="menu-btn btn-primary" />
                <ui:Button text="&#x25C0;&#x25C0;" name="btn-rewind"  class="menu-btn btn-rewind" />
                <ui:Button text="continuar"       name="btn-continue"  class="menu-btn btn-primary" />
                <ui:Button text="nueva partida"   name="btn-new-game"  class="menu-btn btn-danger" />
                <ui:Button text="configuración"   name="btn-settings"  class="menu-btn btn-tertiary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label text="© 2026 frogits · todos los derechos reservados"
                  name="credits" class="credits" picking-mode="Ignore" />

        <ui:VisualElement name="settings-overlay" class="settings-overlay hidden">
            <ui:VisualElement name="settings-backdrop" class="settings-backdrop" />
            <ui:VisualElement name="settings-card" class="settings-card">

                <ui:Button text="✕" name="btn-close-settings" class="settings-close-x" />

                <ui:Label text="Configuración" class="settings-title" />

                <ui:VisualElement class="slider-row">
                    <ui:VisualElement class="slider-head">
                        <ui:Label text="música" class="slider-label" />
                        <ui:Label text="70%" name="val-music" class="slider-value" />
                    </ui:VisualElement>
                    <ui:Slider name="slider-music" low-value="0" high-value="100" value="70" class="bbl-slider" />
                </ui:VisualElement>

                <ui:VisualElement class="slider-row">
                    <ui:VisualElement class="slider-head">
                        <ui:Label text="sfx" class="slider-label" />
                        <ui:Label text="60%" name="val-sfx" class="slider-value" />
                    </ui:VisualElement>
                    <ui:Slider name="slider-sfx" low-value="0" high-value="100" value="60" class="bbl-slider" />
                </ui:VisualElement>

                <ui:VisualElement class="divider" />

                <ui:VisualElement class="save-row">
                    <ui:Button text="guardar" name="btn-save-settings" class="menu-btn btn-primary btn-save-sm" />
                    <ui:Label text="" name="lbl-saved" class="lbl-saved" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>